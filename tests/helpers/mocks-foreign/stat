# Reports one named path as owned by somebody else, and tells the truth
# about everything else.
#
# An unprivileged test suite cannot create a file owned by another user, and
# the check this stands in for -- refusing to keep DNS credentials in a
# directory or a file the running user does not own -- has nothing else to
# look at. It lives outside the directory the other mocks share, so only a
# test that asks for it has it on PATH.
set -euo pipefail

if [[ -n ${PVE_CONFIG_MOCK_FOREIGN_PATH:-} && $* == *'%u'* ]]; then
  for arg in "$@"; do
    if [[ ${arg} == "${PVE_CONFIG_MOCK_FOREIGN_PATH}" ]]; then
      printf '4242\n'
      exit 0
    fi
  done
fi

for candidate in /usr/bin/stat /bin/stat; do
  if [[ -x ${candidate} ]]; then
    exec "${candidate}" "$@"
  fi
done

printf 'stat: not found\n' >&2
exit 127
