# Records the invocation and keeps the users and ACLs it is told about, so
# that "already exists" can be reproduced rather than assumed away.
# shellcheck source=tests/helpers/mocks/_record
source "$(dirname -- "$0")/_record"

mock_state_json() {
  local file=$1 dir line body=''
  dir=$(mock_state_dir) || {
    printf '[]\n'
    return 0
  }
  if [[ -f ${dir}/${file} ]]; then
    while IFS= read -r line; do
      [[ -n ${body} ]] && body+=','
      body+="{${line}}"
    done <"${dir}/${file}"
  fi
  printf '[%s]\n' "${body}"
}

case "$1 ${2:-}" in
  'user list')
    # A listing that cannot be read is how the toolkit meets a user it does
    # not know about, which is the case the "already exists" tolerance
    # exists for.
    [[ ${PVE_CONFIG_MOCK_PVEUM_LIST_FAILS:-0} == 1 ]] && exit 1
    mock_state_json pve-users
    ;;
  'user add')
    if mock_state_has pve-users "\"userid\":\"$3\""; then
      printf "user '%s' already exists\n" "$3" >&2
      exit 2
    fi
    mock_state_add pve-users "\"userid\":\"$3\""
    ;;
  'acl list')
    mock_state_json pve-acls
    ;;
  'acl modify')
    mock_state_add pve-acls "\"path\":\"$3\",\"roleid\":\"${5:-}\",\"ugid\":\"${7:-}\""
    ;;
  *) exit 0 ;;
esac
