# Shared by the recording mocks. Logs the invocation and exposes the scratch
# directory the stateful ones keep their fixtures in.
printf '%s %s\n' "$(basename -- "$0")" "$*" >>"${PVE_CONFIG_MOCK_LOG:-/dev/null}"

mock_state_dir() {
  [[ -n ${PVE_CONFIG_MOCK_STATE:-} ]] || return 1
  mkdir -p -- "${PVE_CONFIG_MOCK_STATE}"
  printf '%s\n' "${PVE_CONFIG_MOCK_STATE}"
}

mock_state_has() {
  local file=$1 value=$2 dir
  dir=$(mock_state_dir) || return 1
  grep -qxF -- "${value}" "${dir}/${file}" 2>/dev/null
}

mock_state_add() {
  local file=$1 value=$2 dir
  dir=$(mock_state_dir) || return 1
  mock_state_has "${file}" "${value}" && return 0
  printf '%s\n' "${value}" >>"${dir}/${file}"
}

mock_state_remove() {
  local file=$1 value=$2 dir
  dir=$(mock_state_dir) || return 1
  [[ -f ${dir}/${file} ]] || return 0
  grep -vxF -- "${value}" "${dir}/${file}" >"${dir}/${file}.new" || true
  mv -f -- "${dir}/${file}.new" "${dir}/${file}"
}

# The first argument that is not an option, and the one after it.
mock_verb_and_target() {
  local arg
  MOCK_VERB=''
  MOCK_TARGET=''
  for arg in "$@"; do
    [[ ${arg} == -* ]] && continue
    if [[ -z ${MOCK_VERB} ]]; then
      MOCK_VERB=${arg}
    elif [[ -z ${MOCK_TARGET} ]]; then
      MOCK_TARGET=${arg}
    fi
  done
}
