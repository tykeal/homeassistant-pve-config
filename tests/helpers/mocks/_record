# Shared by the recording mocks. Logs the invocation and exposes the scratch
# directory the stateful ones keep their fixtures in.
printf '%s %s\n' "$(basename -- "$0")" "$*" >>"${PVE_CONFIG_MOCK_LOG:-/dev/null}"

# Every environment variable this process inherited, so a test can prove a
# credential reached no child of a stage whatever command that child was.
# It goes beside the call log rather than in the state directory, which is
# fingerprinted for convergence.
#
# Each block carries the name of the command it belongs to, because the
# commands a stage runs do not all get the same environment: a local
# administrative tool runs with the stage's own, and anything reaching the
# network runs with an explicit allowlist and nothing else.
if [[ -n ${PVE_CONFIG_MOCK_ENV_LOG:-} ]]; then
  {
    printf '#mock %s\n' "$(basename -- "$0")"
    env
  } >>"${PVE_CONFIG_MOCK_ENV_LOG}"
fi

# Replaces a file the moment a named command runs.
#
# The hazard a stage that verifies a download has to be held to is the
# one where the bytes change between the check and the use. Nothing a
# test can do from the outside lands in that window reliably, so the
# swap is hung off a command the stage runs inside it.
#
#   PVE_CONFIG_MOCK_SWAP_ON       the mock that triggers it
#   PVE_CONFIG_MOCK_SWAP_FILE     the file to overwrite
#   PVE_CONFIG_MOCK_SWAP_SOURCE   the bytes to put there
if [[ -n ${PVE_CONFIG_MOCK_SWAP_ON:-} &&
  $(basename -- "$0") == "${PVE_CONFIG_MOCK_SWAP_ON}" &&
  -n ${PVE_CONFIG_MOCK_SWAP_FILE:-} &&
  -n ${PVE_CONFIG_MOCK_SWAP_SOURCE:-} &&
  -f ${PVE_CONFIG_MOCK_SWAP_SOURCE} ]]; then
  # A replacement rather than a rewrite, which is how a file under
  # another process's control actually changes: the name comes to point
  # at a different object and whoever holds the old one still has it.
  cat -- "${PVE_CONFIG_MOCK_SWAP_SOURCE}" >"${PVE_CONFIG_MOCK_SWAP_FILE}.swap"
  mv -f -- "${PVE_CONFIG_MOCK_SWAP_FILE}.swap" "${PVE_CONFIG_MOCK_SWAP_FILE}"
fi

mock_state_dir() {
  [[ -n ${PVE_CONFIG_MOCK_STATE:-} ]] || return 1
  mkdir -p -- "${PVE_CONFIG_MOCK_STATE}"
  printf '%s\n' "${PVE_CONFIG_MOCK_STATE}"
}

mock_state_has() {
  local file=$1 value=$2 dir
  dir=$(mock_state_dir) || return 1
  grep -qxF -- "${value}" "${dir}/${file}" 2>/dev/null
}

mock_state_add() {
  local file=$1 value=$2 dir
  dir=$(mock_state_dir) || return 1
  mock_state_has "${file}" "${value}" && return 0
  printf '%s\n' "${value}" >>"${dir}/${file}"
}

mock_state_remove() {
  local file=$1 value=$2 dir
  dir=$(mock_state_dir) || return 1
  [[ -f ${dir}/${file} ]] || return 0
  grep -vxF -- "${value}" "${dir}/${file}" >"${dir}/${file}.new" || true
  mv -f -- "${dir}/${file}.new" "${dir}/${file}"
}

# The first argument that is not an option, and the one after it.
mock_verb_and_target() {
  local arg
  MOCK_VERB=''
  MOCK_TARGET=''
  for arg in "$@"; do
    [[ ${arg} == -* ]] && continue
    if [[ -z ${MOCK_VERB} ]]; then
      MOCK_VERB=${arg}
    elif [[ -z ${MOCK_TARGET} ]]; then
      MOCK_TARGET=${arg}
    fi
  done
}
