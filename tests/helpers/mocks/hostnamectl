# Records the invocation and remembers the name, which the hostname mock
# then reports back.
# shellcheck source=tests/helpers/mocks/_record
source "$(dirname -- "$0")/_record"

if [[ ${1:-} == set-hostname && -n ${2:-} ]]; then
  dir=$(mock_state_dir) && printf '%s\n' "$2" >"${dir}/hostname"
fi
exit 0
