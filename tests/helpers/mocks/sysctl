# Keeps the kernel parameters a stage writes, so a second run finds them
# already set. Unknown keys read as the kernel's own defaults, which for
# everything this toolkit touches is 0.
# shellcheck source=tests/helpers/mocks/_record
source "$(dirname -- "$0")/_record"

store() {
  local dir
  dir=$(mock_state_dir) || return 1
  printf '%s\n' "${dir}/sysctl"
}

read_key() {
  local key=$1 path value=''
  path=$(store) || return 1
  if [[ -f ${path} ]]; then
    value=$(sed -n "s|^${key}=||p" "${path}" | tail -n 1)
  fi
  printf '%s\n' "${value:-0}"
}

write_key() {
  local key=$1 value=$2 path
  path=$(store) || return 1
  if [[ -f ${path} ]]; then
    grep -v "^${key}=" "${path}" >"${path}.new" || true
    mv -f -- "${path}.new" "${path}"
  fi
  printf '%s=%s\n' "${key}" "${value}" >>"${path}"
}

mode='read'
quiet=0
args=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -w | --write) mode='write' ;;
    -n | --values) quiet=1 ;;
    -p | --load | --system) exit 0 ;;
    -*) ;;
    *) args+=("$1") ;;
  esac
  shift
done

[[ ${#args[@]} -gt 0 ]] || exit 1

for arg in "${args[@]}"; do
  if [[ ${arg} == *=* ]]; then
    mode='write'
    key=${arg%%=*}
    value=${arg#*=}
    key=${key// /}
    value=${value// /}
    write_key "${key}" "${value}" || exit 1
    [[ ${quiet} == 1 ]] || printf '%s = %s\n' "${key}" "${value}"
    continue
  fi
  if [[ ${mode} == write ]]; then
    printf 'sysctl: malformed setting "%s"\n' "${arg}" >&2
    exit 1
  fi
  value=$(read_key "${arg}") || exit 1
  if [[ ${quiet} == 1 ]]; then
    printf '%s\n' "${value}"
  else
    printf '%s = %s\n' "${arg}" "${value}"
  fi
done
