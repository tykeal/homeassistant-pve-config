# Reports whatever the hostnamectl mock last set. With nothing recorded it
# steps out of the way, so the detection tests still see the real host.
# shellcheck source=tests/helpers/mocks/_record
source "$(dirname -- "$0")/_record"

state=''
if dir=$(mock_state_dir) && [[ -f ${dir}/hostname ]]; then
  state=$(cat "${dir}/hostname")
fi

if [[ -z ${state} ]]; then
  for real in /bin/hostname /usr/bin/hostname; do
    [[ -x ${real} ]] && exec "${real}" "$@"
  done
  exit 1
fi

case ${1:-} in
  -s) printf '%s\n' "${state%%.*}" ;;
  *) printf '%s\n' "${state}" ;;
esac
