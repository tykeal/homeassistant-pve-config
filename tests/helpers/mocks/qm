# Records the invocation and simulates just enough of qemu-server that a
# virtual machine stage can be watched converge: a configuration file per
# vmid under /etc/pve/qemu-server, and a running set the start and stop
# verbs move ids in and out of.
#
# It is deliberately no more forgiving than qm. A `qm create` on an id
# that exists fails, a verb aimed at a machine that does not exist fails
# with the status and the message qm uses, and a tag list qm would refuse
# to store is refused here -- a mock that accepted one would hide the
# stage handing Proxmox something unusable, which is the shape of bug this
# suite has been bitten by before.
#
# Strictness is the point rather than a courtesy. An unknown command, an
# unknown option, an option with no value, an operand too many and a
# value outside the enumeration qm accepts are all refused, because a
# mock that shrugged at them could not fail when production started
# sending one. `--format not-a-format` importing a disk anyway is the
# concrete case: every test would stay green while no node would.
# shellcheck source=tests/helpers/mocks/_record
source "$(dirname -- "$0")/_record"

verb=${1:-}

# `qm disk import --help` is how the upstream builder decides between
# `qm disk import` and the older `qm importdisk`, and it asks before it
# has a vmid to name.
if [[ ${verb} == disk && ${2:-} == import && ${3:-} == --help ]]; then
  printf 'USAGE: qm disk import <vmid> <source> <storage> [OPTIONS]\n'
  exit 0
fi

sub=''
if [[ ${verb} == disk ]]; then
  sub=${2:-}
  vmid=${3:-}
else
  vmid=${2:-}
fi

vm_conf() {
  printf '%s\n' "${PVE_CONFIG_ROOT:-}/etc/pve/qemu-server/${1:-${vmid}}.conf"
}

vm_exists() {
  [[ -f $(vm_conf "${1:-${vmid}}") ]]
}

# qm's own words for a machine this node does not have, and its status.
no_such_vm() {
  printf "Configuration file 'nodes/pve/qemu-server/%s.conf' does not exist\n" \
    "${vmid}" >&2
  exit 2
}

# The tag lists qm will store. One that it would refuse is refused here:
# a mock that took one would hide the stage handing Proxmox something
# unusable, which is the shape of bug this suite has been bitten by.
valid_tags() {
  local tags=$1
  if [[ -n ${tags} && ! ${tags} =~ ^[A-Za-z0-9_.+-]+(\;[A-Za-z0-9_.+-]+)*$ ]]; then
    printf "value '%s' does not look like a valid tag list\n" "${tags}" >&2
    return 1
  fi
}

# qm's refusals. The CLI handler exits 255 on a usage error of any kind,
# and names what it could not take.
usage_error() {
  printf '%s\n' "$1" >&2
  printf 'USAGE: qm <COMMAND> [ARGS] [OPTIONS]\n' >&2
  exit 255
}

# The configuration options this mock takes, which is the set the toolkit
# sends plus the ones a reader of these tests would expect to work. One
# that is not here is an option qm might not have either, and the mock is
# not the place to find out.
known_option() {
  case $1 in
    name | memory | cores | sockets | cpu | net0 | ostype | scsihw | bios | \
      machine | agent | tablet | localtime | onboot | tags | description | \
      vga | efidisk0 | scsi0 | boot | serial0)
      return 0
      ;;
  esac
  return 1
}

# The options the last parse read, by name and in the order they came.
declare -A opts=()
order=()

# Reads `--key value` pairs into opts/order, refusing anything qm would.
# `allow` is the name of a function that says which option names are
# taken, so each verb can have its own set.
parse_options() {
  local allow=$1
  shift
  local key value
  opts=()
  order=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --?* | -?*)
        key=${1#-}
        key=${key#-}
        # qm takes `--key=value` as well as `--key value`.
        if [[ ${key} == *=* ]]; then
          value=${key#*=}
          key=${key%%=*}
          shift
        else
          value=${2-}
          if [[ $# -lt 2 || ${value} == -* ]]; then
            usage_error "option '${key}' requires an argument"
          fi
          shift 2
        fi
        "${allow}" "${key}" || usage_error "Unknown option: ${key}"
        [[ -n ${opts[${key}]:-} ]] || order+=("${key}")
        opts["${key}"]=${value}
        ;;
      *)
        usage_error "too many arguments"
        ;;
    esac
  done
}

# Replaces a key in the configuration, or adds it.
conf_set() {
  local key=$1 value=$2 conf
  conf=$(vm_conf)
  sed -i "/^${key}: /d" -- "${conf}"
  printf '%s: %s\n' "${key}" "${value}" >>"${conf}"
}

conf_get() {
  sed -n "s/^${1}: //p" -- "$(vm_conf)" | head -n 1
}

# The lowest unusedN index the machine does not have.
next_index() {
  local prefix=$1 index=0
  while grep -q "^${prefix}${index}: " -- "$(vm_conf)"; do
    index=$((index + 1))
  done
  printf '%s\n' "${index}"
}

# The next volume name on a storage, which qemu-server numbers per
# machine across every disk it owns.
next_volume() {
  local storage=$1 index=0
  while grep -qE ": ${storage}:vm-${vmid}-disk-${index}(,|$)" -- "$(vm_conf)"; do
    index=$((index + 1))
  done
  printf '%s:vm-%s-disk-%s\n' "${storage}" "${vmid}" "${index}"
}

# qemu-server does not store a disk line the way it was handed one. It
# records the volume, then the settings in alphabetical order, with the
# allocated size among them:
#
#   qm set 200 --scsi0 local-lvm:vm-200-disk-0,ssd=1,discard=on
#   scsi0: local-lvm:vm-200-disk-0,discard=on,size=32G,ssd=1
#
# A mock that stored the string it was given would let a stage that reads
# a disk line back pass on fixtures that nothing on a node ever writes,
# which is the shape of the bug that brought this mock here.
disk_line() {
  local value=$1 size=$2 volume params=''
  volume=${value%%,*}
  params=size=${size}
  if [[ ${value} == *,* ]]; then
    params=$(
      {
        printf '%s' "${value#*,}" | tr ',' '\n' | grep -v '^size='
        printf 'size=%s\n' "${size}"
      } | sort | paste -sd, -
    )
  fi
  printf '%s,%s\n' "${volume}" "${params}"
}

case ${verb} in
  create)
    if vm_exists; then
      printf 'VM %s already exists on node\n' "${vmid}" >&2
      exit 255
    fi
    shift 2
    # qm will not create a machine without an id, and the toolkit's whole
    # adoption story rests on the name being the one it asked for.
    if [[ ! ${vmid} =~ ^[0-9]+$ ]]; then
      printf "unable to parse value of 'vmid'\n" >&2
      exit 255
    fi
    parse_options known_option "$@"
    if [[ -z ${opts[name]:-} ]]; then
      printf 'qm create: a name is required by this mock\n' >&2
      exit 255
    fi
    # qm refuses a tag list it cannot store wherever one is given, the
    # create included.
    if [[ -n ${opts[tags]:-} ]]; then
      valid_tags "${opts[tags]}" || exit 255
    fi
    mkdir -p -- "$(dirname -- "$(vm_conf)")"
    : >"$(vm_conf)"
    # Every option becomes the configuration key of the same name, which
    # is what qemu-server writes: `-machine q35` is `machine: q35`.
    for key in "${order[@]}"; do
      printf '%s: %s\n' "${key}" "${opts[${key}]}" >>"$(vm_conf)"
    done
    sort -o "$(vm_conf)" -- "$(vm_conf)"
    ;;
  set)
    vm_exists || no_such_vm
    shift 2
    parse_options known_option "$@"
    ((${#order[@]} > 0)) || usage_error 'no options specified'
    for key in "${order[@]}"; do
      value=${opts[${key}]}
      case ${key} in
        tags)
          valid_tags "${value}" || exit 255
          sed -i '/^tags: /d' -- "$(vm_conf)"
          [[ -n ${value} ]] && printf 'tags: %s\n' "${value}" >>"$(vm_conf)"
          continue
          ;;
      esac
      case ${key} in
        efidisk0)
          # `storage:0` is an allocation request rather than a volume:
          # qemu-server makes the disk and writes back what it made, at
          # the 4 MB EFI type's size.
          if [[ ${value} =~ ^([^:,]+):0(,(.*))?$ ]]; then
            value=$(next_volume "${BASH_REMATCH[1]}")
            [[ -n ${BASH_REMATCH[3]:-} ]] && value="${value},${BASH_REMATCH[3]}"
          fi
          value=$(disk_line "${value}" 528K)
          ;;
        scsi0)
          value=$(disk_line "${value}" "${PVE_CONFIG_MOCK_QM_DISK_SIZE:-32G}")
          ;;
      esac
      conf_set "${key}" "${value}"
      # Attaching a volume that was sitting as unusedN takes it out of
      # that list, which is what qemu-server does and what makes a second
      # attach of the same volume impossible.
      if [[ ${key} == scsi0 ]]; then
        sed -i "\\|^unused[0-9]*: ${value%%,*}\$|d" -- "$(vm_conf)"
      fi
    done
    ;;
  status)
    (($# <= 2)) || usage_error 'too many arguments'
    [[ -n ${vmid} ]] || usage_error "no value specified for 'vmid'"
    vm_exists || no_such_vm
    # A qm that cannot answer at all: the cluster filesystem is wedged, or
    # the status command fails for a reason the toolkit cannot read. It
    # has to be told apart from a stopped machine.
    if [[ -n ${PVE_CONFIG_MOCK_QM_STATUS_FAIL:-} &&
      ${vmid} == "${PVE_CONFIG_MOCK_QM_STATUS_FAIL}" ]]; then
      printf 'ipcc_send_rec[1] failed: Connection refused\n' >&2
      exit 255
    fi
    # A machine in a state that is neither running nor stopped: paused,
    # suspended, or a migration in flight.
    if [[ -n ${PVE_CONFIG_MOCK_QM_STATUS_SAYS:-} ]]; then
      printf 'status: %s\n' "${PVE_CONFIG_MOCK_QM_STATUS_SAYS}"
      exit 0
    fi
    if mock_state_has running "${vmid}"; then
      printf 'status: running\n'
    else
      printf 'status: stopped\n'
    fi
    ;;
  start)
    (($# <= 2)) || usage_error 'too many arguments'
    [[ -n ${vmid} ]] || usage_error "no value specified for 'vmid'"
    vm_exists || no_such_vm
    if mock_state_has running "${vmid}"; then
      printf 'VM %s already running\n' "${vmid}" >&2
      exit 255
    fi
    mock_state_add running "${vmid}"
    ;;
  stop | shutdown)
    (($# <= 2)) || usage_error 'too many arguments'
    [[ -n ${vmid} ]] || usage_error "no value specified for 'vmid'"
    vm_exists || no_such_vm
    mock_state_remove running "${vmid}"
    ;;
  config)
    (($# <= 2)) || usage_error 'too many arguments'
    [[ -n ${vmid} ]] || usage_error "no value specified for 'vmid'"
    vm_exists || no_such_vm
    cat -- "$(vm_conf)"
    ;;
  resize)
    (($# == 4)) || usage_error 'wrong number of arguments'
    vm_exists || no_such_vm
    disk=${3}
    size=${4}
    # The two operands qm checks before it touches anything: a disk key
    # it knows, and a size in the units it takes. A mock that resized on
    # `scsi0G` or on `64 gigabytes` would let a stage ask for something
    # no node would do.
    [[ ${disk} =~ ^(scsi|virtio|sata|ide|efidisk|tpmstate)[0-9]+$ ]] ||
      usage_error "value '${disk}' does not look like a valid disk name"
    [[ ${size} =~ ^\+?[0-9]+[KMGT]?$ ]] ||
      usage_error "value '${size}' does not look like a valid size"
    line=$(conf_get "${disk}")
    if [[ -z ${line} ]]; then
      printf "disk '%s' does not exist\n" "${disk}" >&2
      exit 255
    fi
    # qm refuses to shrink a disk, which is why the toolkit will not
    # accept a size below the published image's.
    have=${line##*size=}
    have=${have%%,*}
    if [[ ${size%G} =~ ^[0-9]+$ && ${have%G} =~ ^[0-9]+$ ]] &&
      ((${size%G} < ${have%G})); then
      printf "unable to shrink disk size\n" >&2
      exit 255
    fi
    if [[ -n ${PVE_CONFIG_MOCK_QM_RESIZE_FAIL:-} ]]; then
      printf "VM is locked (create)\n" >&2
      exit 255
    fi
    conf_set "${disk}" "$(disk_line "${line}" "${size}")"
    ;;
  disk)
    [[ ${sub} == import ]] ||
      usage_error "Unknown command '${sub}'. Available commands: import, move, rescan, resize, unlink"
    (($# >= 5)) || usage_error 'wrong number of arguments'
    vm_exists || no_such_vm
    source_file=${4}
    storage=${5}
    # Everything past the three operands is an option, and qm takes a
    # short list of them. `--format` is checked against the enumeration
    # it belongs to: an import that took any word there could not fail
    # when the stage started sending one qemu-img has never heard of.
    import_option() {
      case $1 in
        format | 'target-disk' | 'import-from') return 0 ;;
      esac
      return 1
    }
    shift 5
    parse_options import_option "$@"
    if [[ -n ${opts[format]:-} ]]; then
      case ${opts[format]} in
        raw | qcow2 | vmdk) ;;
        *)
          usage_error "format: value '${opts[format]}' does not have a value in the enumeration 'raw, qcow2, vmdk'"
          ;;
      esac
    fi
    # qm reads the image it is given, so an import of something that is
    # not there fails rather than inventing a volume.
    if [[ ! -s ${source_file} ]]; then
      printf "unable to open file '%s'\n" "${source_file}" >&2
      exit 255
    fi
    if [[ -n ${PVE_CONFIG_MOCK_QM_IMPORT_FAIL:-} ]]; then
      printf 'storage %s does not support vm images\n' "${storage}" >&2
      exit 255
    fi
    # The bytes qm was handed, so a test can prove which object was
    # imported rather than which pathname was passed.
    if dir=$(mock_state_dir); then
      sha256sum <"${source_file}" | cut -d' ' -f1 >>"${dir}/imported-sha256"
    fi
    index=$(next_index unused)
    volume=$(next_volume "${storage}")
    printf 'unused%s: %s\n' "${index}" "${volume}" >>"$(vm_conf)"
    # What qm says when the import worked, in the words production uses:
    #
    #   Successfully imported disk as 'unused0:local-lvm:vm-200-disk-0'
    #
    # The configuration key is part of the report, which is why a caller
    # that wants the volume has to take the key off it.
    if [[ ${PVE_CONFIG_MOCK_QM_IMPORT_QUIET:-} == 1 ]]; then
      printf 'transferred 32.0 GiB of 32.0 GiB (100.00%%)\n'
    else
      printf "Successfully imported disk as 'unused%s:%s'\n" \
        "${index}" "${volume}"
    fi
    ;;
  list)
    (($# == 1)) || usage_error 'too many arguments'
    printf 'VMID       Status     Lock         Name\n'
    for conf in "${PVE_CONFIG_ROOT:-}"/etc/pve/qemu-server/*.conf; do
      [[ -f ${conf} ]] || continue
      id=$(basename -- "${conf}")
      id=${id%.conf}
      name=$(sed -n 's/^name: //p' "${conf}" | head -n 1)
      if mock_state_has running "${id}"; then
        printf '%-10s %-10s %-12s %s\n' "${id}" running '' "${name}"
      else
        printf '%-10s %-10s %-12s %s\n' "${id}" stopped '' "${name}"
      fi
    done
    ;;
  '')
    usage_error 'no command specified'
    ;;
  *)
    usage_error "Unknown command '${verb}'. Available commands: config, create, disk, list, resize, set, shutdown, start, status, stop"
    ;;
esac
