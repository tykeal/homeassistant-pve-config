# Records the invocation and answers for the fixture interfaces "mock0" and
# the management bridge. The bridge address comes from the environment so a
# test can model a host that has not been given a lease yet. Any other
# interface is reported as unknown, which is how the real tool behaves and
# is what the degradation tests rely on.
printf '%s %s\n' "$(basename -- "$0")" "$*" >>"${PVE_CONFIG_MOCK_LOG:-/dev/null}"

bridge_ip=${PVE_CONFIG_MOCK_BRIDGE_IP-192.0.2.50}

# The uplink the fixture host routes through. Empty models a host with no
# default route at all, which is the case that has to demand explicit
# configuration rather than guess.
default_dev=${PVE_CONFIG_MOCK_DEFAULT_DEV-nic0}

case "$*" in
  *'route show default')
    [[ -n ${default_dev} ]] || exit 0
    for dev in ${default_dev}; do
      echo "default via 192.0.2.1 dev ${dev} proto dhcp src 192.0.2.50 metric 100"
    done
    ;;
  *'addr show dev mock0')
    echo '2: mock0    inet 192.0.2.10/24 brd 192.0.2.255 scope global mock0'
    ;;
  *'route show dev mock0')
    echo '192.0.2.0/24 proto kernel scope link src 192.0.2.10'
    ;;
  *'addr show dev vmbr0' | *'addr show vmbr0')
    [[ -n ${bridge_ip} ]] || exit 0
    echo "3: vmbr0    inet ${bridge_ip}/24 brd 192.0.2.255 scope global vmbr0"
    ;;
  *'route show dev vmbr0')
    [[ -n ${bridge_ip} ]] || exit 0
    echo '192.0.2.0/24 proto kernel scope link src '"${bridge_ip}"
    ;;
  *)
    echo 'Device does not exist' >&2
    exit 1
    ;;
esac
