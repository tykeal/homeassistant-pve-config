# Records the invocation and remembers what it installed, so a second run
# of the same stage finds the package already present.
# shellcheck source=tests/helpers/mocks/_record
source "$(dirname -- "$0")/_record"

[[ ${1:-} == install ]] || exit 0
shift
for arg in "$@"; do
  [[ ${arg} == -* ]] && continue
  mock_state_add packages "${arg}"
done
