# Records the invocation and remembers what it installed, so a second run
# of the same stage finds the package already present.
# shellcheck source=tests/helpers/mocks/_record
source "$(dirname -- "$0")/_record"

if [[ ${1:-} == update ]]; then
  # Lets a test exercise the retry path: a refresh that failed must still
  # happen on the next run, even though the source files already match.
  [[ ${PVE_CONFIG_MOCK_APT_UPDATE_FAILS:-0} == 1 ]] && exit 1
  exit 0
fi

[[ ${1:-} == install ]] || exit 0
shift
for arg in "$@"; do
  [[ ${arg} == -* ]] && continue
  mock_state_add packages "${arg}"
done
