# Stands in for `passwd -S NAME` and `passwd -l NAME` against the shadow
# fixture that sits beside the passwd database the other account mocks
# keep. Only those two forms are modelled; anything else is recorded and
# refused, because nothing in this toolkit should be running them.
#
# The status really is read back out of the fixture and the lock really
# writes to it, so a second run reports `L` and a stage that locks an
# already locked account has somewhere to be caught.
# shellcheck source=tests/helpers/mocks/_record
source "$(dirname -- "$0")/_record"

passwd_file=${PVE_CONFIG_PASSWD:-/etc/passwd}
shadow_file="${passwd_file%/*}/shadow"

user_exists() {
  awk -F: -v n="$1" '$1 == n { found = 1 } END { exit !found }' \
    "${passwd_file}" 2>/dev/null
}

hash_for() {
  awk -F: -v n="$1" '$1 == n { print $2; exit }' "${shadow_file}" 2>/dev/null
}

# The real tool takes at most one mode option and at most one operand,
# and exits 2 on anything else: `passwd -S root extra` and `passwd -S -l
# root` are both usage errors there. A mock that quietly kept the last of
# each would answer calls production would never make, and would let a
# module that built its argument list wrongly look correct here.
mode=''
name=''
modes=0
operands=0
while [[ $# -gt 0 ]]; do
  case $1 in
    -S | --status)
      mode=status
      modes=$((modes + 1))
      ;;
    -l | --lock)
      mode=lock
      modes=$((modes + 1))
      ;;
    -*)
      printf 'passwd: unrecognized option %s\n' "$1" >&2
      exit 1
      ;;
    *)
      name=$1
      operands=$((operands + 1))
      ;;
  esac
  shift
done

if [[ ${modes} -gt 1 || ${operands} -gt 1 ]]; then
  printf 'passwd: too many arguments\n' >&2
  exit 2
fi

[[ -n ${mode} && -n ${name} ]] || {
  printf 'passwd: this mock models only -S and -l\n' >&2
  exit 1
}

# The real tool refuses an account it cannot find, and a mock that
# answered for one would let a stage harden a container that has no such
# user.
user_exists "${name}" || {
  printf "passwd: user '%s' does not exist\n" "${name}" >&2
  exit 1
}

case ${mode} in
  status)
    if [[ -n ${PVE_CONFIG_MOCK_PASSWD_S_FAIL:-} ]]; then
      printf 'passwd: cannot open /etc/shadow\n' >&2
      exit 1
    fi
    if [[ -n ${PVE_CONFIG_MOCK_PASSWD_STATUS:-} ]]; then
      printf '%s %s 2026-01-01 0 99999 7 -1\n' "${name}" \
        "${PVE_CONFIG_MOCK_PASSWD_STATUS}"
      exit 0
    fi
    hash=$(hash_for "${name}")
    case ${hash} in
      '') state=NP ;;
      '!'* | '*'*) state=L ;;
      *) state=P ;;
    esac
    printf '%s %s 2026-01-01 0 99999 7 -1\n' "${name}" "${state}"
    ;;
  lock)
    if [[ -n ${PVE_CONFIG_MOCK_PASSWD_LOCK_FAIL:-} ]]; then
      printf 'passwd: Permission denied\n' >&2
      exit 1
    fi
    hash=$(hash_for "${name}")
    [[ -n ${hash} ]] || hash='x'
    [[ ${hash} == '!'* ]] || hash="!${hash}"
    touch -- "${shadow_file}"
    tmp="${shadow_file}.mock"
    awk -F: -v n="${name}" -v h="${hash}" 'BEGIN { OFS = ":" }
      $1 == n { $2 = h; found = 1 }
      { print }
      END { if (!found) print n, h, "20000", "0", "99999", "7", "", "", "" }
    ' "${shadow_file}" >"${tmp}"
    mv -f -- "${tmp}" "${shadow_file}"
    printf 'passwd: password expiry information changed.\n'
    ;;
esac
