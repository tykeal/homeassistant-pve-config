# Converges the passwd and group fixtures the way the real tool converges
# the account database.
# shellcheck source=tests/helpers/mocks/_record
source "$(dirname -- "$0")/_record"

shell=''
groups=''
name=''
while [[ $# -gt 0 ]]; do
  case $1 in
    -s)
      shell=$2
      shift
      ;;
    -aG)
      groups=$2
      shift
      ;;
    -*) ;;
    *) name=$1 ;;
  esac
  shift
done

[[ -n ${name} ]] || exit 1

if [[ -n ${shell} && -n ${PVE_CONFIG_PASSWD:-} ]]; then
  awk -F: -v OFS=: -v n="${name}" -v s="${shell}" \
    '$1 == n { $7 = s } { print }' "${PVE_CONFIG_PASSWD}" >"${PVE_CONFIG_PASSWD}.new"
  mv -f -- "${PVE_CONFIG_PASSWD}.new" "${PVE_CONFIG_PASSWD}"
fi

if [[ -n ${groups} && -n ${PVE_CONFIG_GROUP:-} ]]; then
  for group in ${groups//,/ }; do
    if ! awk -F: -v g="${group}" '$1 == g { found = 1 } END { exit !found }' \
      "${PVE_CONFIG_GROUP}" 2>/dev/null; then
      printf '%s:x:9000:\n' "${group}" >>"${PVE_CONFIG_GROUP}"
    fi
    awk -F: -v OFS=: -v g="${group}" -v n="${name}" \
      '$1 == g { $4 = ($4 == "" ? n : $4 "," n) } { print }' \
      "${PVE_CONFIG_GROUP}" >"${PVE_CONFIG_GROUP}.new"
    mv -f -- "${PVE_CONFIG_GROUP}.new" "${PVE_CONFIG_GROUP}"
  done
fi
