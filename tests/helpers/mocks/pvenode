# Records the invocation and keeps just enough ACME state that the
# certificate stage can be asked twice and converge the second time:
# accounts, the DNS plugin with the data pvenode would have stored, the
# node ACME settings, and whatever certificate an order produced.
#
# The plugin data is kept the way pvenode keeps it -- the credentials file
# read off disk and base64url encoded -- so a test can prove the stage
# handed over a path rather than a secret.
# shellcheck source=tests/helpers/mocks/_record
source "$(dirname -- "$0")/_record"

STATE=$(mock_state_dir) || exit 0

mock_json_escape() {
  local value=$1
  value=${value//\\/\\\\}
  printf '%s' "${value//\"/\\\"}"
}

# Lets a test replace what one subcommand prints, or make it fail.
#
# The real pvenode answers with JSON this toolkit has to decide about,
# and the interesting answers are the ones nobody would write on purpose:
# a null where a string belongs, a number where a string belongs, bytes
# that are not UTF-8, a filename that appears twice. A mock that only
# ever prints well formed output is a mock that hides every one of them.
mock_raw() {
  local value
  case $1 in
    ACCOUNT_LIST) value=${PVE_CONFIG_MOCK_RAW_ACCOUNT_LIST-@unset} ;;
    ACCOUNT_INFO) value=${PVE_CONFIG_MOCK_RAW_ACCOUNT_INFO-@unset} ;;
    PLUGIN_LIST) value=${PVE_CONFIG_MOCK_RAW_PLUGIN_LIST-@unset} ;;
    PLUGIN_CONFIG) value=${PVE_CONFIG_MOCK_RAW_PLUGIN_CONFIG-@unset} ;;
    NODE_CONFIG) value=${PVE_CONFIG_MOCK_RAW_NODE_CONFIG-@unset} ;;
    CERT_INFO) value=${PVE_CONFIG_MOCK_RAW_CERT_INFO-@unset} ;;
    *) return 1 ;;
  esac
  [[ ${value} == '@unset' ]] && return 1
  if [[ ${value} == '@fail' ]]; then
    printf 'pvenode: %s is unavailable\n' "$1" >&2
    exit 2
  fi
  # %b so a test can put a NUL byte in the answer with \0000: a NUL is
  # exactly the byte that disappears when output travels through a shell
  # variable, which is what makes it worth being able to send. A test
  # that wants a literal backslash in the JSON doubles it.
  printf '%b\n' "${value}"
  return 0
}

# The argument following a named option, which is how pvenode takes
# everything that is not positional.
mock_option() {
  local want=$1 arg next=''
  shift
  for arg in "$@"; do
    if [[ -n ${next} ]]; then
      printf '%s' "${arg}"
      return 0
    fi
    if [[ ${arg} == "--${want}" ]]; then
      next=1
    fi
  done
  return 1
}

mock_plugin_data() {
  local path=$1
  [[ -f ${path} ]] || {
    printf 'no such credentials file: %s\n' "${path}" >&2
    exit 2
  }
  base64 -w0 <"${path}" | tr '+/' '-_'
}

acme_account_register() {
  local name=$1 contact=$2 directory answer=''
  shift 2
  directory=$(mock_option directory "$@") || directory='unknown'
  # The real command reads the agreement to the terms of service from its
  # standard input and has no option for it, so a caller that does not
  # answer must not succeed here either.
  read -r answer || true
  if [[ ${answer} != y ]]; then
    printf 'the terms of service were not accepted\n' >&2
    exit 1
  fi
  printf '%s %s %s\n' "${name}" "${contact}" "${directory}" >>"${STATE}/acme-accounts"
}

acme_account_list() {
  local body='' name rest
  mock_raw ACCOUNT_LIST && return 0
  if [[ -f ${STATE}/acme-accounts ]]; then
    while read -r name rest; do
      [[ -n ${body} ]] && body+=','
      body+="{\"name\":\"${name}\"}"
    done <"${STATE}/acme-accounts"
  fi
  printf '[%s]\n' "${body}"
}

acme_account_info() {
  local want=$1 name contact directory
  mock_raw ACCOUNT_INFO && return 0
  if [[ -f ${STATE}/acme-accounts ]]; then
    while read -r name contact directory; do
      [[ ${name} == "${want}" ]] || continue
      printf '{"account":{"contact":["mailto:%s"]},"directory":"%s"}\n' \
        "${contact}" "${directory}"
      return 0
    done <"${STATE}/acme-accounts"
  fi
  printf 'no such account: %s\n' "${want}" >&2
  exit 2
}

acme_plugin_add() {
  local id=$1 api data
  shift
  api=$(mock_option api "$@") || api=''
  data=$(mock_plugin_data "$(mock_option data "$@")")
  if [[ -f ${STATE}/acme-plugin-${id} ]]; then
    printf "plugin '%s' already exists\n" "${id}" >&2
    exit 2
  fi
  printf '%s %s %s\n' "${id}" "${api}" "${data}" >"${STATE}/acme-plugin-${id}"
}

acme_plugin_set() {
  local id=$1 api data
  shift
  if [[ ! -f ${STATE}/acme-plugin-${id} ]]; then
    printf "no such plugin: %s\n" "${id}" >&2
    exit 2
  fi
  api=$(mock_option api "$@") || api=''
  data=$(mock_plugin_data "$(mock_option data "$@")")
  printf '%s %s %s\n' "${id}" "${api}" "${data}" >"${STATE}/acme-plugin-${id}"
}

# The plugins pvenode knows about. The real command answers this one for
# a node with no plugins at all, which is how absence is told from a
# pvenode that could not answer.
acme_plugin_list() {
  local body='' file id api data
  mock_raw PLUGIN_LIST && return 0
  for file in "${STATE}"/acme-plugin-*; do
    [[ -e ${file} ]] || continue
    read -r id api data <"${file}"
    [[ -n ${body} ]] && body+=','
    body+="{\"api\":\"${api}\",\"plugin\":\"${id}\",\"type\":\"dns\"}"
  done
  printf '[%s]\n' "${body}"
}

acme_plugin_config() {
  local id=$1 name api data
  mock_raw PLUGIN_CONFIG && return 0
  if [[ ! -f ${STATE}/acme-plugin-${id} ]]; then
    printf "no such plugin: %s\n" "${id}" >&2
    exit 2
  fi
  read -r name api data <"${STATE}/acme-plugin-${id}"
  printf '{"api":"%s","data":"%s","digest":"deadbeef","plugin":"%s","type":"dns"}\n' \
    "${api}" "${data}" "${name}"
}

node_config_get() {
  local body='' key value
  mock_raw NODE_CONFIG && return 0
  if [[ -f ${STATE}/node-config ]]; then
    while IFS='=' read -r key value; do
      [[ -n ${body} ]] && body+=','
      body+="\"${key}\":\"$(mock_json_escape "${value}")\""
    done <"${STATE}/node-config"
  fi
  printf '{%s}\n' "${body}"
}

node_config_set() {
  local acme domain
  acme=$(mock_option acme "$@") || acme=''
  domain=$(mock_option acmedomain0 "$@") || domain=''
  : >"${STATE}/node-config"
  [[ -n ${acme} ]] && printf 'acme=%s\n' "${acme}" >>"${STATE}/node-config"
  [[ -n ${domain} ]] && printf 'acmedomain0=%s\n' "${domain}" >>"${STATE}/node-config"
  return 0
}

# An order reads the node settings the way the real one does, and issues
# from whichever directory the named account was registered against: a
# staging order yields a staging issuer, which is how the stage tells a
# promoted deployment from a converged one.
#
# The fixture keeps the subject, the SAN list and the issuer apart, because
# a real certificate can carry a subject that names one host and a SAN list
# that covers another, and a mock that makes them the same hides a stage
# that reads the wrong one.
acme_cert_order() {
  local acme domain account fqdn directory='' issuer name contact dir
  local mode=$1 forced=no arg
  shift
  for arg in "$@"; do
    [[ ${arg} == '--force' ]] && forced=yes
  done
  # The real pvenode declines to overwrite a certificate that is already
  # there unless it is forced, and renews only one that exists. A mock
  # that issues on demand hides a stage that asks for the wrong one.
  if [[ ${mode} == order && -f ${STATE}/node-cert && ${forced} == no ]]; then
    printf 'custom certificate exists, use --force to overwrite\n' >&2
    exit 2
  fi
  if [[ ${mode} == renew && ! -f ${STATE}/node-cert ]]; then
    printf 'no certificate to renew\n' >&2
    exit 2
  fi
  if [[ ! -f ${STATE}/node-config ]]; then
    printf 'no ACME domain configured\n' >&2
    exit 2
  fi
  acme=$(sed -n 's/^acme=//p' "${STATE}/node-config")
  domain=$(sed -n 's/^acmedomain0=//p' "${STATE}/node-config")
  account=${acme#*account=}
  account=${account%%,*}
  fqdn=${domain%%,*}

  if [[ -f ${STATE}/acme-accounts ]]; then
    while read -r name contact dir; do
      [[ ${name} == "${account}" ]] || continue
      directory=${dir}
    done <"${STATE}/acme-accounts"
  fi
  if [[ -z ${directory} ]]; then
    printf 'no such account: %s\n' "${account}" >&2
    exit 2
  fi

  if [[ ${directory} == *staging* ]]; then
    issuer="C=US,O=(STAGING) Let's Encrypt,CN=(STAGING) Wannabe Watercress R11"
  else
    issuer="C=US,O=Let's Encrypt,CN=R11"
  fi
  # subject|san|issuer|notafter
  printf 'CN=%s|%s|%s|%s\n' "${fqdn}" "${fqdn}" "${issuer}" \
    "$(($(date +%s) + ${PVE_CONFIG_MOCK_CERT_DAYS:-90} * 86400))" \
    >"${STATE}/node-cert"
}

# The certificate listing, with the failure modes a host really has: a
# command that fails, one that says nothing, and one whose output is not
# the JSON this toolkit expects.
cert_info() {
  local subject san issuer notafter body=''
  mock_raw CERT_INFO && return 0
  case ${PVE_CONFIG_MOCK_CERT_INFO:-} in
    fail)
      printf 'unable to read the certificate store\n' >&2
      exit 2
      ;;
    empty) return 0 ;;
    garbage)
      printf 'not json at all\n'
      return 0
      ;;
    raw)
      # Whatever the test wants the listing to be: JSON that decodes to
      # the wrong shape, a string carrying a comma or a bracket, a
      # filename that appears twice.
      printf '%s\n' "${PVE_CONFIG_MOCK_CERT_RAW:-}"
      return 0
      ;;
  esac

  if [[ ! -f ${STATE}/node-cert ]]; then
    # A host that has never ordered one still serves the self signed pair
    # the installer made.
    printf '[{"filename":"pve-ssl.pem","issuer":"CN=Proxmox Virtual Environment","notafter":%s,"san":["localhost"],"subject":"CN=localhost"}]\n' \
      "$(($(date +%s) + 86400))"
    return 0
  fi
  IFS='|' read -r subject san issuer notafter <"${STATE}/node-cert"
  local name
  for name in ${san//,/ }; do
    [[ -n ${body} ]] && body+=','
    body+="\"$(mock_json_escape "${name}")\""
  done
  printf '[{"filename":"pveproxy-ssl.pem","issuer":"%s","notafter":%s,"san":[%s],"subject":"%s"}]\n' \
    "$(mock_json_escape "${issuer}")" "${notafter}" "${body}" \
    "$(mock_json_escape "${subject}")"
}

case "${1:-} ${2:-} ${3:-}" in
  'acme account register') acme_account_register "${4:-default}" "${5:-}" "$@" ;;
  'acme account list') acme_account_list ;;
  'acme account info') acme_account_info "${4:-default}" ;;
  'acme plugin add') acme_plugin_add "${5:-}" "$@" ;;
  'acme plugin set') acme_plugin_set "${4:-}" "$@" ;;
  'acme plugin list') acme_plugin_list ;;
  'acme plugin config') acme_plugin_config "${4:-}" ;;
  'acme cert order') acme_cert_order order "$@" ;;
  'acme cert renew') acme_cert_order renew "$@" ;;
  'cert info '*) cert_info ;;
  'config get '*) node_config_get ;;
  'config set '*) node_config_set "$@" ;;
  *) exit 0 ;;
esac
