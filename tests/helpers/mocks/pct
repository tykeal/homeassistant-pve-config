# Records the invocation and simulates just enough of a container that the
# guest target can be exercised: a root filesystem per vmid, and commands
# that actually run against it.
#
# `exec` runs the wrapper script for real, so the quoting across the pct
# boundary is the quoting a real container would see. Arguments that name a
# path are relocated under the simulated root first, which is what lets a
# non-root runner with no Proxmox tooling watch a stage converge.
# shellcheck source=tests/helpers/mocks/_record
source "$(dirname -- "$0")/_record"

verb=${1:-}
vmid=${2:-}

# A container this host cannot reach. The toolkit has to tell this apart
# from a command that ran and failed, so the mock reproduces both.
if [[ -n ${PVE_CONFIG_MOCK_PCT_FAIL_VMID:-} && ${vmid} == "${PVE_CONFIG_MOCK_PCT_FAIL_VMID}" ]]; then
  printf "Configuration file 'nodes/pve/lxc/%s.conf' does not exist\n" "${vmid}" >&2
  exit 255
fi

# Where this node keeps a container's configuration. pmxcfs puts it under
# /etc/pve; a test points PVE_CONFIG_ROOT at a scratch tree.
ct_conf() {
  local id=${1:-${vmid}}
  printf '%s\n' "${PVE_CONFIG_ROOT:-}/etc/pve/lxc/${id}.conf"
}

ct_exists() {
  [[ -f $(ct_conf "${1:-${vmid}}") ]]
}

guest_root() {
  local dir
  dir=$(mock_state_dir) || return 1
  local root="${dir}/guests/${vmid}/rootfs"
  if [[ ! -d ${root}/etc ]]; then
    mkdir -p -- "${root}/etc" "${root}/home"
    printf 'root:x:0:0::/root:/bin/bash\n' >"${root}/etc/passwd"
    printf 'root:x:0:\nsudo:x:27:\n' >"${root}/etc/group"
    # A container knows which Debian it is, and the toolkit reads that
    # rather than assuming the node's release.
    printf '%s\n' 'PRETTY_NAME="Debian GNU/Linux 13 (trixie)"' \
      'NAME="Debian GNU/Linux"' 'ID=debian' 'VERSION_ID="13"' \
      'VERSION_CODENAME=trixie' >"${root}/etc/os-release"
  fi
  printf '%s\n' "${root}"
}

guest_state() {
  local dir
  dir=$(mock_state_dir) || return 1
  mkdir -p -- "${dir}/guests/${vmid}/state"
  printf '%s\n' "${dir}/guests/${vmid}/state"
}

# Tools whose operands are paths in the container rather than opaque
# values. `useradd -s /bin/bash` names a shell the container will record,
# not a file this mock should relocate, so the list is deliberately short.
is_path_tool() {
  case $1 in
    mkdir | rmdir | chmod | chown | rm | stat | test | cat | touch | ln | readlink) return 0 ;;
    # sha256sum is given the keyring's path inside the container.
    sha256sum) return 0 ;;
    # Only curl's -o operand is an absolute path; the URL is not.
    curl) return 0 ;;
    *) return 1 ;;
  esac
}

# --perms as pct itself reads it: a value with no leading zero gets one,
# and the result is parsed base 0 -- octal, or hexadecimal with an 0x
# prefix. A mock more forgiving than the real tool hides the bugs it exists
# to catch, so an unparsable mode fails here as it would there.
apply_perms() {
  local path=$1 perms=$2 mode
  [[ ${perms} == 0* ]] || perms="0${perms}"
  case ${perms} in
    0[xX]*)
      [[ ${perms} =~ ^0[xX][0-9a-fA-F]+$ ]] || {
        printf "invalid mode: '%s'\n" "$2" >&2
        exit 2
      }
      mode=$((perms))
      ;;
    *)
      [[ ${perms} =~ ^0[0-7]+$ ]] || {
        printf "invalid mode: '%s'\n" "$2" >&2
        exit 2
      }
      mode=$((8#${perms}))
      ;;
  esac
  chmod -- "$(printf '%04o' "${mode}")" "${path}"
}

case ${verb} in
  exec)
    root=$(guest_root) || exit 1
    state=$(guest_state) || exit 1
    shift 2

    # pct keeps the caller's environment unless told otherwise, and
    # lxc-attach --clear-env wipes it. A mock that always inherited would
    # let a leak of host secrets into the container pass unnoticed, so the
    # option is honoured here exactly as pct honours it.
    keep_env=1
    while [[ $# -gt 0 && $1 != '--' ]]; do
      case $1 in
        --keep-env)
          keep_env=${2:-1}
          shift 2
          ;;
        --keep-env=*)
          keep_env=${1#*=}
          shift
          ;;
        *) shift ;;
      esac
    done
    [[ ${1:-} == '--' ]] && shift
    # Anything that is not the toolkit's wrapper is recorded and nothing
    # more, which is all the older stage tests ever wanted from this mock.
    [[ ${1:-} == '/bin/sh' && ${2:-} == '-c' ]] || exit 0
    script=$3
    tag=$4
    token=${5:-}
    envc=${6:-0}
    shift 6

    # Lets a test drive the case where pct reports success without the
    # wrapper ever having run.
    if [[ ${PVE_CONFIG_MOCK_PCT_NO_SENTINEL:-0} == 1 ]]; then
      exit 0
    fi

    # The wrapper's own environment arguments, passed through untouched
    # apart from PATH: the tools this container has are the mocks, so that
    # is where its PATH points.
    guest_env=()
    while [[ ${envc} -gt 0 ]]; do
      case ${1-} in
        PATH=*) guest_env+=("PATH=$(dirname -- "$0"):${PATH}") ;;
        *) guest_env+=("${1-}") ;;
      esac
      shift
      envc=$((envc - 1))
    done

    args=()
    if is_path_tool "${1:-}"; then
      for arg in "$@"; do
        if [[ ${arg} == /* ]]; then
          args+=("${root}${arg}")
        else
          args+=("${arg}")
        fi
      done
    else
      args=("$@")
    fi

    # A pct that cannot reach the container at all: the command never
    # runs, and the toolkit sees the transport's status rather than the
    # command's. Matched on the command line the wrapper was handed.
    if [[ -n ${PVE_CONFIG_MOCK_PCT_EXEC_FAIL:-} &&
      " ${*} " == *" ${PVE_CONFIG_MOCK_PCT_EXEC_FAIL} "* ]]; then
      printf 'pct: unable to open file - No such file or directory\n' >&2
      exit 255
    fi

    # A link that drops after the removal has gone through: the rm runs,
    # and everything about that path afterwards fails at the transport.
    # Modelled on the removal rather than on a call count, so it still
    # lands on the verification step if the steps before it change.
    if [[ -n ${PVE_CONFIG_MOCK_PCT_FAIL_AFTER_RM:-} ]]; then
      if dir=$(mock_state_dir); then
        marker="${dir}/pct-fail-after-rm"
        if [[ -f ${marker} && " ${*} " == *" ${PVE_CONFIG_MOCK_PCT_FAIL_AFTER_RM} "* ]]; then
          printf 'pct: unable to open file - No such file or directory\n' >&2
          exit 255
        fi
        if [[ ${1:-} == rm ]]; then
          for arg in "$@"; do
            if [[ ${arg} == "${PVE_CONFIG_MOCK_PCT_FAIL_AFTER_RM}" ]]; then
              : >"${marker}"
              break
            fi
          done
        fi
      fi
    fi

    # A removal that reports success and leaves the file there: an
    # overlay that swallows the unlink, a bind mount, a filesystem gone
    # read-only after the fact. A toolkit that believes rm's status
    # leaves an auth key on disk and says nothing.
    if [[ -n ${PVE_CONFIG_MOCK_PCT_RM_NOOP:-} && ${1:-} == rm ]]; then
      for arg in "$@"; do
        if [[ ${arg} == *"${PVE_CONFIG_MOCK_PCT_RM_NOOP}" ]]; then
          # Through the wrapper still, so the toolkit sees a command that
          # ran and reported success rather than a transport failure.
          args=(true)
          break
        fi
      done
    fi

    # A removal that is refused inside the container, which is a command
    # failure rather than a transport one.
    if [[ -n ${PVE_CONFIG_MOCK_PCT_FAIL_RM:-} && ${1:-} == rm ]]; then
      for arg in "$@"; do
        if [[ ${arg} == *"${PVE_CONFIG_MOCK_PCT_FAIL_RM}" ]]; then
          # A command that ran and failed, which is not the same thing as
          # a pct that could not reach the container.
          args=(sh -c "printf \"rm: cannot remove '%s': Operation not permitted\\n\" \"\$1\" >&2; exit 1" rm "${PVE_CONFIG_MOCK_PCT_FAIL_RM}")
          break
        fi
      done
    fi

    # What the simulated container supplies of itself, as opposed to what
    # the toolkit asked for: its account databases, its own scratch state
    # and the log the mocks inside it record to.
    container_env=(
      "PVE_CONFIG_PASSWD=${root}/etc/passwd"
      "PVE_CONFIG_GROUP=${root}/etc/group"
      "PVE_CONFIG_MOCK_STATE=${state}"
      "PVE_CONFIG_MOCK_GUEST_ROOT=${root}"
      "PVE_CONFIG_MOCK_LOG=${PVE_CONFIG_MOCK_LOG:-/dev/null}"
      'PVE_CONFIG_MOCK_HOME_BASE=/home'
      'PVE_CONFIG_ROOT='
    )

    # Fault knobs a test uses to model something going wrong inside the
    # container. The real pct carries nothing in, so these are listed one
    # by one rather than leaking the caller's whole environment.
    for knob in PVE_CONFIG_MOCK_TAILSCALE_UP_FAIL \
      PVE_CONFIG_MOCK_TAILSCALE_STATE \
      PVE_CONFIG_MOCK_CURL_FAIL_URL \
      PVE_CONFIG_MOCK_APT_UPDATE_FAILS \
      PVE_CONFIG_MOCK_DEFAULT_DEV \
      PVE_CONFIG_MOCK_BRIDGE_IP \
      PVE_CONFIG_MOCK_TAILSCALE_STATUS_JSON \
      PVE_CONFIG_MOCK_TAILSCALE_STATUS_FAIL \
      PVE_CONFIG_MOCK_KEYRING_PAYLOAD; do
      if [[ -n ${!knob:-} ]]; then
        container_env+=("${knob}=${!knob}")
      fi
    done

    runner=(env)
    [[ ${keep_env} == 0 ]] && runner=(env -i)

    "${runner[@]}" "${container_env[@]}" \
      /bin/sh -c "${script}" "${tag}" "${token}" "${#guest_env[@]}" \
      ${guest_env[@]+"${guest_env[@]}"} ${args[@]+"${args[@]}"}
    ;;
  push)
    root=$(guest_root) || exit 1
    src=${3:-}
    dest=${4:-}
    # A run that is interrupted while the file is on its way in. The
    # signal goes to the stage rather than to this subshell, because the
    # removal that follows the push belongs to the stage's shell and a
    # signal delivered anywhere else would still let it run.
    if [[ -n ${PVE_CONFIG_MOCK_PCT_SIGNAL_ON_PUSH:-} &&
      ${dest} == "${PVE_CONFIG_MOCK_PCT_SIGNAL_ON_PUSH}" ]]; then
      #
      # The outermost ancestor that matches is the one to signal. A
      # command substitution forks a subshell whose cmdline is the same
      # script, and that subshell does not run the stage's traps: the
      # nearest match would be killed without the cleanup ever running,
      # which is the opposite of what this is here to exercise.
      signal_pid=$$
      signal_found=''
      while [[ ${signal_pid} -gt 1 ]]; do
        if [[ -r /proc/${signal_pid}/cmdline ]] &&
          grep -qa "${PVE_CONFIG_MOCK_PCT_SIGNAL_TARGET:-20-tailscale.sh}" \
            "/proc/${signal_pid}/cmdline"; then
          signal_found=${signal_pid}
        fi
        signal_pid=$(awk '{print $4}' "/proc/${signal_pid}/stat" 2>/dev/null) || break
        [[ -n ${signal_pid} ]] || break
      done
      [[ -n ${signal_found} ]] && kill -s TERM "${signal_found}"
      exit 0
    fi
    perms=''
    while [[ $# -gt 0 ]]; do
      if [[ $1 == --perms ]]; then
        perms=${2:-}
      fi
      shift
    done
    [[ -f ${src} ]] || exit 2
    mkdir -p -- "$(dirname -- "${root}${dest}")"
    cp -- "${src}" "${root}${dest}" || exit 2
    [[ -n ${perms} ]] && apply_perms "${root}${dest}" "${perms}"
    ;;
  pull)
    root=$(guest_root) || exit 1
    src=${3:-}
    dest=${4:-}
    if [[ ! -f ${root}${src} ]]; then
      printf 'unable to open file - No such file or directory\n' >&2
      exit 2
    fi
    cp -- "${root}${src}" "${dest}" || exit 2
    ;;
  create)
    # `pct create <vmid> <template> --option value ...`. Enough of it is
    # modelled that a stage can find the container afterwards and read
    # back what it asked for.
    conf=$(ct_conf)
    if ct_exists; then
      printf 'CT %s already exists on node\n' "${vmid}" >&2
      exit 255
    fi
    shift 2
    hostname=''
    unprivileged=''
    features=''
    memory=''
    cores=''
    while [[ $# -gt 0 ]]; do
      case $1 in
        -hostname | --hostname)
          hostname=${2:-}
          shift 2
          ;;
        -unprivileged | --unprivileged)
          unprivileged=${2:-}
          shift 2
          ;;
        -features | --features)
          features=${2:-}
          shift 2
          ;;
        -memory | --memory)
          memory=${2:-}
          shift 2
          ;;
        -cores | --cores)
          cores=${2:-}
          shift 2
          ;;
        *) shift ;;
      esac
    done
    if [[ -z ${hostname} ]]; then
      printf 'pct create: a hostname is required by this mock\n' >&2
      exit 255
    fi
    mkdir -p -- "$(dirname -- "${conf}")"
    {
      printf 'arch: amd64\n'
      printf 'hostname: %s\n' "${hostname}"
      [[ -n ${memory} ]] && printf 'memory: %s\n' "${memory}"
      [[ -n ${cores} ]] && printf 'cores: %s\n' "${cores}"
      [[ -n ${features} ]] && printf 'features: %s\n' "${features}"
      [[ -n ${unprivileged} ]] && printf 'unprivileged: %s\n' "${unprivileged}"
      printf 'ostype: debian\n'
    } >"${conf}"
    guest_root >/dev/null
    ;;
  status)
    if ! ct_exists; then
      printf "Configuration file 'nodes/pve/lxc/%s.conf' does not exist\n" "${vmid}" >&2
      exit 2
    fi
    if mock_state_has running "${vmid}"; then
      printf 'status: running\n'
    else
      printf 'status: stopped\n'
    fi
    ;;
  start | reboot)
    if ! ct_exists; then
      printf "Configuration file 'nodes/pve/lxc/%s.conf' does not exist\n" "${vmid}" >&2
      exit 2
    fi
    root=$(guest_root) || exit 1
    # The configuration is read when the container starts, which is why a
    # TUN line added to a running container does nothing until it is
    # restarted. The mock models that: /dev/net/tun appears and
    # disappears with the mount entry, as of the last start.
    if grep -q '^lxc\.mount\.entry: /dev/net/tun ' "$(ct_conf)"; then
      mkdir -p -- "${root}/dev/net"
      : >"${root}/dev/net/tun"
    else
      rm -f -- "${root}/dev/net/tun"
    fi
    mock_state_add running "${vmid}"
    ;;
  stop | shutdown)
    ct_exists || exit 2
    mock_state_remove running "${vmid}"
    ;;
  list)
    printf 'VMID       Status     Lock         Name\n'
    for conf in "${PVE_CONFIG_ROOT:-}"/etc/pve/lxc/*.conf; do
      [[ -f ${conf} ]] || continue
      id=$(basename -- "${conf}")
      id=${id%.conf}
      name=$(sed -n 's/^hostname: //p' "${conf}" | head -n 1)
      if mock_state_has running "${id}"; then
        printf '%-10s %-10s %-12s %s\n' "${id}" running '' "${name}"
      else
        printf '%-10s %-10s %-12s %s\n' "${id}" stopped '' "${name}"
      fi
    done
    ;;
  config)
    ct_exists || exit 2
    cat -- "$(ct_conf)"
    ;;
  set)
    if ! ct_exists; then
      printf "Configuration file 'nodes/pve/lxc/%s.conf' does not exist\n" "${vmid}" >&2
      exit 2
    fi
    conf=$(ct_conf)
    shift 2
    while [[ $# -gt 0 ]]; do
      case $1 in
        -tags | --tags)
          tags=${2:-}
          # pct refuses a tag list it cannot store, and a mock that took
          # one would hide the stage handing it something unusable.
          if [[ -n ${tags} && ! ${tags} =~ ^[A-Za-z0-9_.+-]+(\;[A-Za-z0-9_.+-]+)*$ ]]; then
            printf "value '%s' does not look like a valid tag list\n" "${tags}" >&2
            exit 255
          fi
          sed -i '/^tags: /d' -- "${conf}"
          [[ -n ${tags} ]] && printf 'tags: %s\n' "${tags}" >>"${conf}"
          shift 2
          ;;
        *) shift ;;
      esac
    done
    ;;
  *) exit 0 ;;
esac
