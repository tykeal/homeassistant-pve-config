#
# Settings for pve-baseline.sh and pve-guests.sh.
#
# Copy this file to pve-config.env next to the scripts, fill it in, and keep
# it private:
#
#   cp pve-config.env.example pve-config.env
#   chmod 0600 pve-config.env
#
# pve-config.env is git-ignored. Never commit real keys or credentials.
# The file is sourced by bash, so quote values that contain spaces.
# Any value still containing CHANGEME stops the scripts.

# --- Host (pve-baseline.sh) -------------------------------------------------

# DNS domain for this host. The short hostname is the one given in the
# installer; the FQDN becomes <short-hostname>.<DOMAIN>.
DOMAIN="CHANGEME.example.com"

# Physical NICs to put on vmbr0. Blank means every wired NIC found.
BRIDGE_PORTS=""

# --- Administrator (both scripts) -------------------------------------------

# Login created on the host and inside the Tailscale container. Gets sudo
# through the forwarded SSH agent (pam_ssh_agent_auth) and PVEAdmin on /.
ADMIN_USER="CHANGEME"

# One or more SSH public keys, one per line.
ADMIN_PUBKEYS="ssh-ed25519 AAAA-CHANGEME-replace-with-your-public-key admin@example"

# --- Zulip boot/shutdown notifications (pve-baseline.sh, optional) ----------

# Leave blank to install the notifier inactive. To turn it on later, see
# /etc/zulip-notify.env on the host.
ZULIP_URL=""         # e.g. https://your-org.zulipchat.com
ZULIP_BOT_EMAIL=""   # e.g. proxmox-bot@your-org.zulipchat.com
ZULIP_API_KEY=""
ZULIP_STREAM="infrastructure"

# --- ACME certificate (pve-guests.sh, optional) -----------------------------

# Let's Encrypt certificates through the DNS Made Easy API: one for the
# Proxmox web UI (<short-hostname>.<DOMAIN>) and one for Frigate
# (<short-hostname>-frigate.<DOMAIN>, issued by acme.sh inside the Frigate
# container). Leave DME_API_KEY blank to skip both.
ACME_EMAIL="CHANGEME@example.com"
DME_API_KEY=""       # https://cp.dnsmadeeasy.com/account/info
DME_API_SECRET=""
ACME_STAGING=0       # 1 = Let's Encrypt staging (untrusted test certs)
ACME_SH_REF="3.1.6"  # acmesh-official/acme.sh release tag for Frigate

# --- Guest storage (pve-guests.sh) ------------------------------------------

# Blank picks the first storage that can hold the content type, which is
# right on a stock install (local-lvm or local-zfs, and local).
GUEST_STORAGE=""     # VM disks and container root disks
TEMPLATE_STORAGE=""  # container templates

# --- Home Assistant OS VM (pve-guests.sh) -----------------------------------

HAOS_VMID=200
HAOS_HOSTNAME="homeassistant"
HAOS_CORES=2
HAOS_RAM_MB=4096

# --- Tailscale subnet router container (pve-guests.sh) ----------------------

TS_CTID=100
TS_HOSTNAME=""       # blank = ts-<short-hostname>
# Auth key from https://login.tailscale.com/admin/settings/keys. Use a
# reusable or one-off key, ideally tagged so key expiry is off and the
# advertised routes are auto-approved (see README).
TS_AUTHKEY="tskey-auth-CHANGEME"
TS_CORES=1
TS_RAM_MB=512
TS_DISK_GB=2

# --- Frigate NVR container (pve-guests.sh) ----------------------------------

FRIGATE_CTID=101
FRIGATE_HOSTNAME="frigate"
FRIGATE_CORES=""     # blank = half the host's cores, 2 to 8
FRIGATE_RAM_MB=""    # blank = a quarter of the host's RAM, 2048 to 6144
FRIGATE_DISK_GB=25
FRIGATE_GPU="auto"   # auto (yes when /dev/dri exists), yes or no
# Frigate runs as the official Docker image under Docker Compose in
# /opt/frigate inside the container.
FRIGATE_IMAGE_TAG="stable"  # ghcr.io/blakeblackshear/frigate tag
FRIGATE_SHM_SIZE="512mb"    # /dev/shm; see Frigate's shm-size calculator

# --- community-scripts pins (pve-guests.sh) ---------------------------------

# Commits of community-scripts/ProxmoxVE and community-scripts/core that the
# guest builders are fetched from. Set both to "main" to track upstream.
COMMUNITY_SCRIPTS_REF="d4613af2edc1aac0e63ff9ea7c6d1ae03f2f43f3"
COMMUNITY_SCRIPTS_CORE_REF="e889c3a6a56201fd47d500954cc44b88fccebf94"
