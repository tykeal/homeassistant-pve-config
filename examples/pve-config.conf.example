# Template for /root/pve-config/pve-config.conf.
#
# The real file lives on the host and is never committed. You do not have to
# create it by hand: the driver prompts for whatever it cannot derive and
# writes the answers here, so the second run is unattended. Copy this file
# only when you want to pre-seed a deployment.
#
# Every key is also honoured as an environment variable, which takes
# precedence over the value stored here.

# --- Identity -------------------------------------------------------------

# Short hostname and DNS domain. The driver derives the hostname from the
# running system and the FQDN from the two, so in practice you only answer
# the domain.
PVE_HOSTNAME='pve1'
PVE_DOMAIN='example.net'
PVE_FQDN='pve1.example.net'

# --- Networking -----------------------------------------------------------

# Physical interfaces to enslave to the management bridge, space separated.
# Left unset, the interface carrying the default route is used, and only
# that one: putting two live ports in a bridge with STP off invites a
# broadcast storm, and on a larger host it merges storage or WAN with
# management. Set this when the uplink cannot be identified, or when the
# bridge should hold something other than it.
PVE_BRIDGE_PORTS=''

# Management bridge addressing mode: dhcp or static. The bridge itself is
# always vmbr0; that name is fixed by convention and is not configurable.
PVE_BRIDGE_MODE='dhcp'

# Only consulted when PVE_BRIDGE_MODE is static.
PVE_BRIDGE_ADDRESS=''
PVE_BRIDGE_GATEWAY=''

# How long to wait for vmbr0 to pick up an address before giving up. The
# network stage will not write /etc/hosts without a real address.
PVE_NETWORK_WAIT_SECONDS='60'

# The network stage owns /etc/network/interfaces and describes only lo, the
# bridge ports and vmbr0 in it. It stops when that file also describes
# something else -- a storage port with an address, a VLAN, a second bridge
# -- rather than taking those networks down. Move them into
# /etc/network/interfaces.d, or set this to yes to replace the file anyway.
PVE_NETWORK_TAKEOVER='no'

# --- Repositories ---------------------------------------------------------

# Debian suite for the Proxmox apt sources. Read from VERSION_CODENAME in
# /etc/os-release when unset; override only to pin an older suite.
# PVE_SUITE='trixie'

# Use the no-subscription repository and suppress the subscription notice.
PVE_NO_SUBSCRIPTION='yes'

# --- Administrators -------------------------------------------------------

# Space separated local usernames to create, add to sudo, and register in
# Proxmox with the PVEAdmin role.
PVE_ADMIN_USERS='alice'

# Public key source shared by every admin above. The value is either a
# literal key or a path to a file holding one or more keys. Both forms work;
# the path form keeps long keys out of this file. It may be left unset when
# every admin has a key of their own below; what is checked is that each
# admin ends up covered, and that every key is one ssh-keygen accepts.
PVE_ADMIN_KEY_SOURCE='ssh-ed25519 AAAAC3Nza... alice@example.net'
# PVE_ADMIN_KEY_SOURCE='/root/pve-config/keys/admins.pub'
#
# A per-user source overrides it, as PVE_ADMIN_KEY_<USERNAME>, uppercased.
# PVE_ADMIN_KEY_ALICE='/root/pve-config/keys/alice.pub'

# Allow sudo without a password when the caller forwards an SSH agent
# holding one of the keys above (pam_ssh_agent_auth).
PVE_SUDO_SSH_AGENT='yes'

# Where the administrators above may reach a container's sshd from once
# they have been mirrored into it. 'tailnet' restricts it to the Tailscale
# tunnel, in the container's own nftables ruleset as well as in sshd's
# AllowUsers; 'lan' does neither and lets anything that can route to the
# container reach sshd.
PVE_GUEST_ADMIN_SSH_ACCESS='tailnet'

# --- Certificates ---------------------------------------------------------

# Order a Let's Encrypt certificate for PVE_FQDN over the DNS-01 challenge.
# Leave this at no when something else terminates TLS for this host.
PVE_ACME_ENABLED='no'

# ACME environment: staging or production. Staging is the default because
# Let's Encrypt rate limits are unforgiving and a failed first attempt on
# production can lock a deployment out for a week. Move to production once
# a staging order has succeeded.
PVE_ACME_ENVIRONMENT='staging'

# Contact address for the ACME account and for expiry warnings.
PVE_ACME_EMAIL='admin@example.net'

# DNS-01 plugin name registered with pvenode. DNS Made Easy is the only
# supported provider, so dnsmadeeasy is the only accepted value, and its
# credentials belong in secrets.env.
PVE_ACME_DNS_PLUGIN='dnsmadeeasy'

# Registering an ACME account accepts the CA terms of service. Read them at
# https://letsencrypt.org/repository/ and set this to yes; the certificate
# stage stops before registration while it is no.
PVE_ACME_ACCEPT_TOS='no'

# Order a certificate even when the host already holds a current one. This
# is for cycling a staging order while you get the DNS right, so the
# toolkit refuses it when PVE_ACME_ENVIRONMENT is production.
PVE_ACME_FORCE_ORDER='no'

# --- Guests ---------------------------------------------------------------

# Build the Tailscale subnet router LXC. It needs PVE_TAILSCALE_AUTHKEY in
# secrets.env, and it advertises your LAN into the tailnet, so it stays off
# until you ask for it.
PVE_TAILSCALE_ENABLED='no'

# Hostname for the Tailscale LXC. Its container ID is 100 when that is
# free, otherwise the first free ID, unless you pin one here. The stage
# tags the container it builds and adopts the tagged one on a later run,
# so nothing it did not build is touched.
PVE_TAILSCALE_HOSTNAME='ts-pve1'
PVE_TAILSCALE_CTID=''

# Adopt a container this toolkit did not build. Set this to yes only when
# PVE_TAILSCALE_CTID really does name your subnet router: the stage then
# reboots it, gives it /dev/net/tun, installs packages in it and joins it
# to your tailnet.
PVE_TAILSCALE_ADOPT_EXISTING='no'

# Subnets the router advertises, comma separated. Blank means the IPv4
# subnet of the management bridge, which is the usual single-LAN case; the
# helper in the container re-derives it on every boot, so a DHCP change
# does not leave a stale route advertised.
PVE_TAILSCALE_ROUTES=''

# Storage for the container's template and root disk. Blank is fine when
# the node has exactly one storage of each kind; name one when it has
# several, because the community-scripts builder would otherwise want a
# menu answered.
#
# The two are resolved apart, because the usual Proxmox layout keeps
# templates on local and root disks on local-lvm or a ZFS pool, and one
# name cannot serve both there. PVE_TAILSCALE_STORAGE is the fallback for
# whichever of the two you leave blank, and it has to accept both content
# types when you use it that way.
PVE_TAILSCALE_STORAGE=''
PVE_TAILSCALE_TEMPLATE_STORAGE=''
PVE_TAILSCALE_CONTAINER_STORAGE=''

# SHA-256 the Tailscale repository signing key must have. The stage pins
# the current one and refuses a key that does not match it, because apt
# installs packages as root from the repository it signs. Set this only
# when Tailscale rotates the key and you have verified the new one.
PVE_TAILSCALE_KEYRING_SHA256=''

# Resources for the router. Blank RAM and core values are derived from the
# host's totals, between 256 MB and 1024 MB and one or two cores; the disk
# defaults to 2 GB.
PVE_TAILSCALE_RAM_MB=''
PVE_TAILSCALE_CORES=''
PVE_TAILSCALE_DISK_GB=''

# Builds the Home Assistant OS appliance as a virtual machine, from the
# image the project publishes. Nothing is converged inside it: HAOS is a
# closed appliance with its own onboarding, its own authentication and its
# own updates, so the administrators phase 1 creates on the host do not
# reach into it.
PVE_HAOS_ENABLED='no'

# The machine's name, as Proxmox and the LAN see it.
PVE_HAOS_HOSTNAME='haos'

# Guest ID for the appliance. Blank means 200 by convention, or the next
# free ID when 200 is taken. Set it when this node already uses 200 for
# something else.
PVE_HAOS_VMID=''

# Lets the stage take over a virtual machine it did not build: it tags it,
# starts it, and says so in the log. PVE_HAOS_VMID must name the machine,
# because adoption is never automatic. Leave this 'no' unless a Home
# Assistant you built by hand really is the appliance this node should
# converge.
PVE_HAOS_ADOPT_EXISTING='no'

# Storage for the appliance's EFI and root disks. Blank picks the node's
# only storage that accepts disk images; a node with more than one is
# asked rather than guessed at.
PVE_HAOS_STORAGE=''

# Resources for the appliance. Blank RAM and core values are derived from
# the host's totals -- an eighth of memory between 2048 MB and 8192 MB,
# a quarter of the cores between two and four. The disk defaults to 32 GB,
# which is the size of the published image; smaller is refused because qm
# does not shrink a disk.
PVE_HAOS_RAM_MB=''
PVE_HAOS_CORES=''
PVE_HAOS_DISK_GB=''

# The Home Assistant OS release to install, and the SHA-256 of its disk
# image. Both are pinned in the toolkit and both are blank here. The stage
# downloads the image itself and checks the digest before the image
# becomes a disk, so a download that does not match the pin builds
# nothing. Set the two together, from the release's own SHA256SUMS asset,
# to install a release this toolkit has not caught up with; either one
# alone stops the stage.
PVE_HAOS_VERSION=''
PVE_HAOS_IMAGE_SHA256=''

# Hostname for the Frigate LXC.
PVE_FRIGATE_HOSTNAME='frigate'
PVE_FRIGATE_CTID=''

# --- Community scripts ----------------------------------------------------

# The guest stages drive the community-scripts helpers, and the two
# repositories they come from are pinned in lib/community-scripts.sh rather
# than here. The pins belong to the toolkit, not to a deployment: every site
# a given release builds has to get the same scripts, so they ship with the
# code and move when the code is tested against a newer pair.

# --- Notifications --------------------------------------------------------

# Boot and shutdown notices to a Zulip stream. Credentials belong in
# secrets.env.
PVE_ZULIP_ENABLED='no'
PVE_ZULIP_STREAM='infrastructure'
PVE_ZULIP_TOPIC='proxmox'
