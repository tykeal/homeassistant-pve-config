# Sends the notice from ExecStop: ordered after network-online.target, the
# unit stops before networking does at shutdown.
[Unit]
Description=Send Zulip shutdown notification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/zulip-notify.sh shutdown
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
