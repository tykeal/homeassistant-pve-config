[Unit]
Description=Send Zulip shutdown notification
DefaultDependencies=no
Before=shutdown.target
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/zulip-notify.sh shutdown
TimeoutStartSec=15

[Install]
WantedBy=shutdown.target
